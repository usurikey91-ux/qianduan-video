+async def ensure_platform_sources(session: AsyncSession) -> list[DataSource]:
+    """Provision the four workbench adapters in every new local database."""
+    result = await session.execute(
+        select(DataSource).where(DataSource.channel_type == "opencli")
+    )
+    existing = {
+        str((item.channel_config or {}).get("site") or "").strip().lower(): item
+        for item in result.scalars().all()
+        if isinstance(item.channel_config, dict)
+    }
+    sources: list[DataSource] = []
+    for platform, definition in PLATFORM_SOURCE_DEFINITIONS.items():
+        source = existing.get(platform)
+        config = {
+            "site": platform,
+            "command": definition["command"],
+            "account_argument": definition["account_argument"],
+            "format": "json",
+            "args": dict(definition["args"]),
+            "content_monitoring": {},
+        }
+        if source is None:
+            source = DataSource(
+                name=definition["name"],
+                description=definition["description"],
+                channel_type="opencli",
+                channel_config=config,
+                tags=["content-workbench", "benchmark", platform],
+                enabled=True,
+            )
+            session.add(source)
+        else:
+            source.name = definition["name"]
+            source.description = definition["description"]
+            source.channel_config = config
+            source.tags = ["content-workbench", "benchmark", platform]
+            source.enabled = True
+        sources.append(source)
+    await session.flush()
+    return sources
+
