+def extract_creator_identity(page: Any) -> dict[str, Any]:
+    """Read the visible creator nickname without returning browser credentials."""
+    try:
+        payload = page.evaluate(
+            r"""
+            () => {
+              const nameNode = [...document.querySelectorAll('[class^="name-"]')]
+                .find(node => {
+                  const text = (node.innerText || '').trim();
+                  return text && text.length <= 30;
+                });
+              const avatarNode = nameNode && nameNode.parentElement
+                ? nameNode.parentElement.querySelector('img')
+                : null;
+              return nameNode ? {
+                display_name: (nameNode.innerText || '').trim(),
+                avatar_url: avatarNode ? (avatarNode.currentSrc || avatarNode.src || '') : ''
+              } : {};
+            }
+            """
+        )
+    except Exception:
+        return {}
+    if not isinstance(payload, dict):
+        return {}
+    return {key: value for key, value in payload.items() if value not in (None, "")}
+
+
+def extract_account_overview(page: Any) -> dict[str, Any]:
+    """Read creator-only account traffic and fan facts from the signed-in page."""
+    payload = page.evaluate(
+        r"""
+        async () => {
+          const getJson = async path => {
+            try {
+              const response = await fetch(path, {credentials: 'include'});
+              return response.ok ? await response.json() : {};
+            } catch (_) {
+              return {};
+            }
+          };
+          const [overview, fans, portrait] = await Promise.all([
+            getJson('/aweme/janus/creator/data/overview/all/?last_days_type=1'),
+            getJson('/janus/douyin/creator/data/overview/dashboard/fans?recent_days=7'),
+            getJson('/web/api/creator/center/fans/index/config?aid=1128')
+          ]);
+          return {overview, fans, portrait};
+        }
+        """
+    )
+    payload = payload if isinstance(payload, dict) else {}
+    overview = payload.get("overview") if isinstance(payload.get("overview"), dict) else {}
+    overview_data = overview.get("data") if isinstance(overview.get("data"), dict) else {}
+    fan_payload = payload.get("fans") if isinstance(payload.get("fans"), dict) else {}
+    portrait = payload.get("portrait") if isinstance(payload.get("portrait"), dict) else {}
+
+    traffic_labels = {
+        "post_search": "作品搜索",
+        "account_search": "账号搜索",
+        "profile": "主页访问",
+        "share": "作品分享",
+    }
+    traffic_sources = []
+    for key, label in traffic_labels.items():
+        source = overview_data.get(key)
+        if not isinstance(source, dict) or source.get("current_count") in (None, ""):
+            continue
+        traffic_sources.append({
+            "key": key,
+            "label": label,
+            "value": source.get("current_count"),
+            "trend": source.get("option_list") if isinstance(source.get("option_list"), list) else [],
+        })
+
+    fan_metrics = []
+    for metric in fan_payload.get("metrics") or []:
+        if not isinstance(metric, dict) or not metric.get("metric_name"):
+            continue
+        fan_metrics.append({
+            "key": metric.get("english_metric_name"),
+            "label": metric.get("metric_name"),
+            "value": metric.get("metric_value"),
+            "trend": metric.get("trends") if isinstance(metric.get("trends"), list) else [],
+        })
+
+    portrait_available = bool(portrait.get("enable"))
+    return {
+        "period": "7d",
+        "account_identity": extract_creator_identity(page),
+        "traffic_sources": traffic_sources,
+        "fan_metrics": fan_metrics,
+        "audience_profile": [],
+        "audience_profile_available": portrait_available,
+        "audience_profile_note": (
+            "平台已开放用户画像，但当前连接器尚未返回画像明细。"
+            if portrait_available
+            else "抖音当前未向该账号开放用户画像数据。"
+        ),
+    }
+
